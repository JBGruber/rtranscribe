#!/bin/sh
# Windows (Rtools / UCRT / MinGW) build of the vendored transcribe.cpp.
#
# STATUS: UNPROVEN. DESCRIPTION currently carries `OS_type: unix`, so this
# script is not reached by a normal install. It is kept in the tree as the
# starting point for Windows support; drop the OS_type field once a Windows
# R-CMD-check run is green.
#
# Differences from the POSIX `configure`:
#   * CMake needs an explicit MinGW/MSYS generator, since it would otherwise
#     pick the Visual Studio generator when MSVC is present.
#   * Rtools ships its own gcc/g++; those must be used so the archives are ABI
#     compatible with the package DLL.
#   * The system library set differs (bcrypt/advapi32 instead of dl/pthread).
set -e

: "${R_HOME:?R_HOME is not set; run this via R CMD INSTALL}"
RBIN="${R_HOME}/bin/R"

if [ -z "${CMAKE:-}" ]; then
  CMAKE="$(command -v cmake 2>/dev/null || true)"
fi
if [ -z "$CMAKE" ]; then
  echo "ERROR: cmake not found. Install it (e.g. 'pacman -S mingw-w64-ucrt-x86_64-cmake'" >&2
  echo "       inside Rtools, or from https://cmake.org/download/) and retry." >&2
  exit 1
fi

VENDOR="src/transcribe-cpp"
BUILD="${VENDOR}/build"
PREFIX="${PWD}/${VENDOR}/install"

CC_FULL="$("$RBIN" CMD config CC)"
CXX_FULL="$("$RBIN" CMD config CXX)"
CC_BIN="${CC_FULL%% *}"
CXX_BIN="${CXX_FULL%% *}"

if [ "${TRANSCRIBE_R_NATIVE:-0}" = "1" ]; then
  CPUFLAGS="-DGGML_NATIVE=ON"
else
  CPUFLAGS="-DTRANSCRIBE_X86_CONSERVATIVE=ON -DGGML_NATIVE=OFF"
fi

NJOBS="${TRANSCRIBE_R_JOBS:-2}"

# GPU backends: same opt-in knobs as the POSIX configure, minus Metal. Both are
# even less proven than the rest of this script.
VULKAN_FLAG="-DTRANSCRIBE_VULKAN=OFF"
CUDA_FLAG="-DTRANSCRIBE_CUDA=OFF"
CUDA_EXTRA=""
GPU_LIBS=""

if [ "${TRANSCRIBE_R_VULKAN:-0}" = "1" ]; then
  if [ ! -d "${VENDOR}/ggml/src/ggml-vulkan" ]; then
    echo "ERROR: TRANSCRIBE_R_VULKAN=1 but ${VENDOR}/ggml/src/ggml-vulkan is missing;" >&2
    echo "       add it to the allowlist in tools/vendor.sh and re-vendor." >&2
    exit 1
  fi
  GLSLC="${Vulkan_GLSLC_EXECUTABLE:-$(command -v glslc 2>/dev/null || true)}"
  if [ -z "$GLSLC" ]; then
    echo "ERROR: TRANSCRIBE_R_VULKAN=1 needs the Vulkan SDK and glslc on the PATH." >&2
    exit 1
  fi
  VULKAN_FLAG="-DTRANSCRIBE_VULKAN=ON"
  GPU_LIBS="$GPU_LIBS -lvulkan-1"
fi

if [ "${TRANSCRIBE_R_CUDA:-0}" = "1" ]; then
  if [ ! -d "${VENDOR}/ggml/src/ggml-cuda" ]; then
    echo "ERROR: TRANSCRIBE_R_CUDA=1 but ${VENDOR}/ggml/src/ggml-cuda is missing;" >&2
    echo "       add it to the allowlist in tools/vendor.sh and re-vendor." >&2
    exit 1
  fi
  NVCC="${CUDACXX:-$(command -v nvcc 2>/dev/null || true)}"
  if [ -z "$NVCC" ]; then
    echo "ERROR: TRANSCRIBE_R_CUDA=1 needs the CUDA toolkit (nvcc) on the PATH." >&2
    exit 1
  fi
  CUDA_FLAG="-DTRANSCRIBE_CUDA=ON"
  CUDA_EXTRA="-DCMAKE_CUDA_COMPILER=$NVCC"
  if [ -n "${TRANSCRIBE_R_CUDA_ARCHS:-}" ]; then
    CUDA_EXTRA="$CUDA_EXTRA -DCMAKE_CUDA_ARCHITECTURES=${TRANSCRIBE_R_CUDA_ARCHS}"
  fi
  CUDA_ROOT="$(dirname "$(dirname "$NVCC")")"
  # ggml-cuda's own dependencies are PRIVATE to that target, so they are absent
  # from the link manifest — see the same fixup in `configure`.
  [ -d "$CUDA_ROOT/lib/x64" ] && GPU_LIBS="$GPU_LIBS -L$CUDA_ROOT/lib/x64"
  GPU_LIBS="$GPU_LIBS -lcudart -lcublas -lcuda"
fi

# mingw-w64's <processthreadsapi.h> declares PROCESS_POWER_THROTTLING_STATE
# but not the (real Windows SDK) THREAD_POWER_THROTTLING_STATE counterpart
# ggml-cpu.c uses for per-thread power throttling. The two have identical
# layout and constants in the real SDK, so alias them at the preprocessor
# level rather than patching the vendored source.
MINGW_FIX="-DTHREAD_POWER_THROTTLING_STATE=PROCESS_POWER_THROTTLING_STATE -DTHREAD_POWER_THROTTLING_CURRENT_VERSION=PROCESS_POWER_THROTTLING_CURRENT_VERSION -DTHREAD_POWER_THROTTLING_EXECUTION_SPEED=PROCESS_POWER_THROTTLING_EXECUTION_SPEED"

"$CMAKE" -S "$VENDOR" -B "$BUILD" -G "MSYS Makefiles" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="$CC_BIN" \
  -DCMAKE_CXX_COMPILER="$CXX_BIN" \
  -DCMAKE_C_FLAGS="$MINGW_FIX" \
  -DCMAKE_CXX_FLAGS="$MINGW_FIX" \
  -DCMAKE_INSTALL_PREFIX="$PREFIX" \
  -DTRANSCRIBE_BUILD_SHARED=OFF \
  -DTRANSCRIBE_INSTALL=ON \
  -DTRANSCRIBE_BUILD_TESTS=OFF \
  -DTRANSCRIBE_BUILD_EXAMPLES=OFF \
  -DTRANSCRIBE_BUILD_TOOLS=OFF \
  -DTRANSCRIBE_USE_OPENMP=OFF \
  -DTRANSCRIBE_USE_SYSTEM_BLAS=OFF \
  -DGGML_CCACHE=OFF \
  $VULKAN_FLAG $CUDA_FLAG $CUDA_EXTRA \
  $CPUFLAGS

"$CMAKE" --build "$BUILD" --config Release -j "$NJOBS"
"$CMAKE" --install "$BUILD" >/dev/null

LIBDIR="$PREFIX/lib"
[ -d "$LIBDIR" ] || LIBDIR="$PREFIX/lib64"

MANIFEST="$LIBDIR/transcribe-link.json"
json_array() {
  sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p" "$1" \
    | tr ',' '\n' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' \
    | grep -v '^$' || true
}

ARCHIVES=""
if [ -f "$MANIFEST" ]; then
  for l in $(json_array "$MANIFEST" libraries); do
    # ggml's own CMakeLists strips the "lib" prefix for its Windows archives
    # (libtranscribe.a keeps it, ggml.a/ggml-cpu.a/ggml-base.a do not), so
    # the manifest's bare name may resolve to either file on disk.
    if [ -f "$LIBDIR/lib${l}.a" ]; then
      ARCHIVES="$ARCHIVES $LIBDIR/lib${l}.a"
    elif [ -f "$LIBDIR/${l}.a" ]; then
      ARCHIVES="$ARCHIVES $LIBDIR/${l}.a"
    fi
  done
fi
[ -z "$ARCHIVES" ] && ARCHIVES="$(ls "$LIBDIR"/*.a 2>/dev/null | tr '\n' ' ')"
if [ -z "$ARCHIVES" ]; then
  echo "ERROR: no static archives found in $LIBDIR" >&2
  exit 1
fi

PKG_LIBS="-Wl,--start-group ${ARCHIVES} -Wl,--end-group -lstdc++ -lpthread -lbcrypt -ladvapi32${GPU_LIBS}"
VENDOR_INC="${PWD}/${VENDOR}/include"

sed -e "s|@PKG_LIBS@|${PKG_LIBS}|" \
    -e "s|@VENDOR_INC@|${VENDOR_INC}|" \
    src/Makevars.win.in > src/Makevars.win

exit 0
